ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
 $(error Undefined YAUL_INSTALL_ROOT)
endif
SH_PROGRAM:= wrestlefest-full-game
SH_BUILD_DIR:= build/saturn
SH_OUTPUT_DIR:= build/disc
include $(YAUL_INSTALL_ROOT)/share/build.pre.mk
BUILTIN_ASSETS+= build/frontend-assets/MODEX.RLE;asset_modex
BUILTIN_ASSETS+= build/frontend-assets/MODE.PAL;asset_modepal
BUILTIN_ASSETS+= build/frontend-assets/CURSOR0.BIN;asset_cursor0
BUILTIN_ASSETS+= build/frontend-assets/CURSOR0.PAL;asset_cursor0pal
BUILTIN_ASSETS+= build/frontend-assets/SELBG.RLE;asset_selbg
BUILTIN_ASSETS+= build/frontend-assets/SELWORLD.RLE;asset_selworld
BUILTIN_ASSETS+= build/frontend-assets/SELPAL.BIN;asset_selpal
SH_SRCS:= src/saturn/main.c src/saturn/wf_platform.c build/frontend/renderer.c src/wf_cart.c src/wf_arcade_clock.c src/wf_frontend.c
SH_CFLAGS+= -Os -Isrc -Isrc/saturn -Ivendor/frontend_test03 -Wall -Wextra -Werror -Wno-misleading-indentation
IMAGE_DIRECTORY:= build/cd
AUDIO_TRACKS_DIRECTORY:= build/empty-audio
IP_VERSION:= V0.003
IP_RELEASE_DATE:= 20261031
IP_AREAS:= JTUBKAEL
IP_PERIPHERALS:= J
IP_TITLE:= WWF FULL GAME INTEGRATION 03
IP_MASTER_STACK_ADDR:= 0x06004000
IP_SLAVE_STACK_ADDR:= 0x06001E00
IP_1ST_READ_ADDR:= 0x06004000
IP_1ST_READ_SIZE:= 0
include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk
