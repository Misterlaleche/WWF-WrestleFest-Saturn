ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
 $(error Undefined YAUL_INSTALL_ROOT)
endif
SH_PROGRAM:= wrestlefest-full-game
SH_BUILD_DIR:= build/saturn
SH_OUTPUT_DIR:= build/disc
include $(YAUL_INSTALL_ROOT)/share/build.pre.mk
SH_SRCS:= src/saturn/main.c src/saturn/wf_platform.c build/frontend/renderer.c src/wf_cart.c src/wf_arcade_clock.c src/wf_frontend.c src/wf_assets.c src/wf_roster_identity.c src/saturn/wf_cd.c src/saturn/wf_frontend_resources.c
SH_SRCS+= build/frontend/wf_r18_cdfs.c
SH_SRCS+= build/frontend/wp1979_cd_read.c
SH_CFLAGS+= -Os -Isrc -Isrc/saturn -Ibuild/frontend -Ivendor/frontend_test03 -Wall -Wextra -Werror -Wno-misleading-indentation
IMAGE_DIRECTORY:= build/cd
AUDIO_TRACKS_DIRECTORY:= build/empty-audio
IP_VERSION:= V0.004
IP_RELEASE_DATE:= 20261031
IP_AREAS:= JTUBKAEL
IP_PERIPHERALS:= J
IP_TITLE:= WWF FULL GAME INTEGRATION 04
IP_MASTER_STACK_ADDR:= 0x06004000
IP_SLAVE_STACK_ADDR:= 0x06001E00
IP_1ST_READ_ADDR:= 0x06004000
IP_1ST_READ_SIZE:= 0
include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk
