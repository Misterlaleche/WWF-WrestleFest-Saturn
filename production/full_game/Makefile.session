ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
 $(error Undefined YAUL_INSTALL_ROOT)
endif
SH_PROGRAM:= wrestlefest-session08
SH_BUILD_DIR:= build/session-saturn
SH_OUTPUT_DIR:= build/session-disc
include $(YAUL_INSTALL_ROOT)/share/build.pre.mk
SH_SRCS:= src/saturn/session_main.c src/saturn/wf_platform.c src/saturn/wf_failure_screen.c src/saturn/wf_live_video.c src/saturn/wf_workspace.c src/saturn/wf_combat_saturn.c src/saturn/wf_cd.c src/wf_cart.c src/wf_arcade_clock.c src/wf_pacer.c src/wf_assets.c src/wf_board.c src/wf_video_plan.c build/frontend/wf_r18_cdfs.c build/frontend/wp1979_cd_read.c
SH_CFLAGS+= -Os -Isrc -Isrc/saturn -Ibuild/frontend -Ibuild/session-video -Ibuild/session-include -Wall -Wextra -Werror -Wno-misleading-indentation
SH_SRCS+= src/saturn/wf_startup_notice.c
SH_CFLAGS+= -DWF_SATURN_HWRAM_HOT_INDEX_BYTES=0x14000u
WF_NATIVE_PROFILE?= 0
SH_CFLAGS+= -DWF_NATIVE_PROFILE=$(WF_NATIVE_PROFILE)
SH_SRCS+= src/wf_damage.c
SH_SRCS+= src/wf_combat_diagnostic.c
SH_LDFLAGS+= -flto -Os build/session-core/libwf_session.a
IMAGE_DIRECTORY:= build/session-cd
AUDIO_TRACKS_DIRECTORY:= build/empty-audio
IP_VERSION:= V0.008
IP_RELEASE_DATE:= 20261031
IP_AREAS:= JTUBKAEL
IP_PERIPHERALS:= J
IP_TITLE:= WWF FULL GAME SESSION INTEGRATION 08
IP_MASTER_STACK_ADDR:= 0x06004000
IP_SLAVE_STACK_ADDR:= 0x06001E00
IP_1ST_READ_ADDR:= 0x06004000
IP_1ST_READ_SIZE:= 0
include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk
