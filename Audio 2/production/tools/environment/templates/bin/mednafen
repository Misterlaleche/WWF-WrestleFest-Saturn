#!/usr/bin/env bash
set -euo pipefail
WF_MEDNAFEN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LD_LIBRARY_PATH="$WF_MEDNAFEN_ROOT/host/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MEDNAFEN_HOME="${MEDNAFEN_HOME:-$WF_MEDNAFEN_ROOT/mednafen-home}"
mkdir -p "$MEDNAFEN_HOME"
exec "$WF_MEDNAFEN_ROOT/mednafen/bin/mednafen" "$@"
