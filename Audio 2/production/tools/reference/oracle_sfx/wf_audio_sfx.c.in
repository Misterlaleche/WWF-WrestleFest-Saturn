#include "wf_audio_sfx.h"
@ROM_DERIVED_COMMAND_TABLE@

static wf_sfx_voice_t voices[3];
static uint8_t current_bank;
const wf_sfx_command_t *wf_sfx_command(unsigned command){
 if(command<WF_SFX_FIRST_COMMAND||command>WF_SFX_LAST_COMMAND)return 0;
 return &wf_sfx_commands[command-WF_SFX_FIRST_COMMAND];
}
const wf_sfx_voice_t *wf_sfx_voice(unsigned index){return index<3u?&voices[index]:0;}
void wf_sfx_runtime_reset(void){
 unsigned i; for(i=0;i<3u;i++)voices[i]=(wf_sfx_voice_t){0}; current_bank=0u;
}
static int choose_voice(uint8_t p){
 unsigned i,best=0;
 for(i=0;i<3u;i++)if(!voices[i].active)return (int)i;
 for(i=1;i<3u;i++)if(voices[i].priority<voices[best].priority)best=i;
 return p>=voices[best].priority?(int)best:-1;
}
static void fire_event(unsigned v,const wf_sfx_command_t *c,wf_sfx_play_fn play,void *user){
 wf_sfx_voice_t *s=&voices[v];
 if(s->event_index>=c->event_count)return;
 const wf_sfx_event_t *e=&c->events[s->event_index];
 if(play)play(v,s->bank,e->sample_id,e->volume_nibble,(e->flags&1u)!=0u,user);
 s->ticks_remaining=e->delay_ticks;
}
int wf_sfx_start_voice(unsigned command,wf_sfx_play_fn play,wf_sfx_stop_fn stop,void *user){
 const wf_sfx_command_t *c=wf_sfx_command(command); if(!c)return -1;
 if(c->event_count==0u)return 3;
 int vi=choose_voice(c->priority); if(vi<0)return -1;
 unsigned v=(unsigned)vi;
 if(voices[v].active&&stop)stop(v,user);
 if(c->bank_policy<2u)current_bank=c->bank_policy;
 voices[v]=(wf_sfx_voice_t){true,(uint8_t)command,0u,0u,c->priority,current_bank};
 fire_event(v,c,play,user); return vi;
}
bool wf_sfx_start(unsigned command,wf_sfx_play_fn play,wf_sfx_stop_fn stop,void *user){
 return wf_sfx_start_voice(command,play,stop,user)>=0;
}
void wf_sfx_timer_a_tick(wf_sfx_play_fn play,wf_sfx_stop_fn stop,void *user){
 unsigned v;
 for(v=0;v<3u;v++){
  wf_sfx_voice_t *s=&voices[v]; if(!s->active)continue;
  const wf_sfx_command_t *c=wf_sfx_command(s->command);
  if(!c){s->active=false;continue;}
  if(s->ticks_remaining){--s->ticks_remaining;if(s->ticks_remaining)continue;}
  ++s->event_index;
  if(s->event_index>=c->event_count){
   if(c->cleanup_stop&&stop)stop(v,user);
   s->active=false;continue;
  }
  fire_event(v,c,play,user);
 }
}
