  "requirements": [
    {
      "id": "INPUTS",
      "require": "Exact master/module/debug/SCSP/debug/SFX pack/ROM/source/layout/harness/core/cue/BIN/BIOS/input script hashes and compiler identities; reject changes before first job"
    },
    {
      "id": "ROUTES",
      "require": "All98 SFX commands traverse wf_r18_scsp_audio, host FIFO and firmware ARCADE_WORD, not only direct OKI_START;18 native scores and00/1F lifecycle commands explicitly observed"
    },
    {
      "id": "HOST_MATRIX",
      "require": "18x98 short HOST routing/state matrix, reference A15/A16 priority/bank oracle and R01 musical events; not1764 long emulator boots"
    },
    {
      "id": "PCM_ALL",
      "require": "114 bank entries/95 unique samples complete PCM vs audited golden PAK, original sequence tails, all98 sequences and30000 mixed ticks"
    },
    {
      "id": "PRIORITY",
      "require": "Three occupied logical voices: lower rejection, equal/higher preemption and deterministic victim; retain bank selector2, F1 suppression and no-op20"
    },
    {
      "id": "LONG_SCORE",
      "require": "All18 R01 intro/observed-loop or natural-end coverage, exact CPU/RAM/timer/native events;0B/0C/11 remain finite600s observations with explicit incomplete-loop label"
    },
    {
      "id": "FADE_END",
      "require": "Observe fade flagC062 clear, native-activeC006 clear, FM key mask/levels and final OKI stop against R01; no new score activity after closure, allow existing SFX tails"
    },
    {
      "id": "STOP_RACE",
      "require": "00/new-track/late old mailbox stop; generation ACK discards stale music, stopsPCM3, preserves current effects and newer FM ownership; stop pressure fails closed while gameplay continues"
    },
    {
      "id": "MIX_LONG",
      "require": "Representative long full-system stress: startup-heavy02, write-burst12, long0B/0C/11 as needed from measured worst windows; three SFX logical voices plus musicalPCM3, bursts/fades/new generations"
    },
    {
      "id": "DEADLINES",
      "require": "Zero FM drops, real32-bit PCM underruns, mailbox underruns, unsupported/invalid required commands, queue loss, ignored or disabled audio; expected priority rejection must match oracle"
    },
    {
      "id": "CONTINUITY",
      "require": "Event/cycle progress and expected note/PCM activity in oracle-active windows; no blanket nonzero RMS rule for intentional rests or natural end; RMS alone never certifies a score"
    },
    {
      "id": "GRAPHICS",
      "require": "Same pinned master/seed/input/assets, same completed game-frame scene hashes/render workload; actual stable combat>=600game advances; no extra video blanks for same advances"
    },
    {
      "id": "OBSERVATION",
      "require": "Exact M68K compiler-derived engine sizeof/offsetof and debug/release load identity, native profiles4D46/53F1, live32-bit counters plus mailbox; missing data blocks certification"
    },
    {
      "id": "NEGATIVE_CONTAINMENT",
      "require": "Deliberate starvation stops affected PCM voice and increments underrun without setting engine fault or blocking port; that negative run must still fail delivery gate"
    },
    {
      "id": "MEDIA",
      "require": "No BIN/CUE before complete evidence and user authorization; R04/canonical untouched; no relaxed tolerance, mute, resampling, guest-memory/state edits or substituted audio"
    }
  ],
