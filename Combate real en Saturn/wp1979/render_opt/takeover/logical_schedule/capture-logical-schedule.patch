+def prepare_schedule(raw):
+    # Preserve historical stable sorting for frame-only schedules. A mixed
+    # schedule is an ordered queue: unlike clocks cannot be sorted together.
+    for event in raw:
+        keys = [key for key in ('frame', 'observed_game_frame') if key in event]
+        if len(keys) != 1 or type(event[keys[0]]) is not int or event[keys[0]] < 0:
+            raise ValueError('Each event needs exactly one nonnegative integer frame or observed_game_frame')
+        if event.get('port', 0) not in (0, 1) or any(b not in buttons for b in event.get('buttons', [])):
+            raise ValueError('Invalid controller port or button name')
+    return raw if any('observed_game_frame' in event for event in raw) else sorted(raw, key=lambda event: event['frame'])
+
+def schedule_due(event, frame, observed_game_frame):
+    if 'frame' in event:
+        return event['frame'] <= frame
+    return observed_game_frame is not None and event['observed_game_frame'] <= observed_game_frame
 
