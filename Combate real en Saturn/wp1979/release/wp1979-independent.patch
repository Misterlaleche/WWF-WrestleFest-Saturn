+                  'a72456d5077da334a2dd461d7eafff51dedcce2e:src/runtime/'+name])
+            target.write_bytes(data)
+        runtime=frozen
+    sources=[runtime/n for n in units]
+    if not baseline:
+        sources += [runtime/'src/wf_r18_scsp.c']
