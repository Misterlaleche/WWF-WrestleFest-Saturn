#define CHECK(c) do{if(!(c)){fprintf(stderr,"FAIL %s line %d: %s\n",name,__LINE__,#c);return 1;}}while(0)
int main(int argc,char **argv){
 assert(argc==3);const char *name=argv[1];bool diagnostics=atoi(argv[2])!=0;
 __jo_cd_initialized=true;
 alignas(4) char buffer[8192];payload.resize(sizeof buffer);
 for(unsigned i=0;i<payload.size();++i)payload[i]=(i*7u+i/256u)&255u;
 jo_fs_handle handle={true,1000,8192,4,0};
 jo_file file={};file.handle=&handle;file.read_buffer=buffer;file.read_buffer_size=2048;file.read_index=19;
 unsigned reads=0,starts=0,retries=0,errors=0,timeouts=0,reason=0,failed_status=0,failed_command=0;
 unsigned original_field=frames;
 if(!strcmp(name,"success")){
  answer=4;CHECK(__jo_fs_read_sectors(&handle,4,buffer,sizeof buffer)==8192);
  CHECK(handle.position==4 && !memcmp(buffer,payload.data(),8192));reads=starts=1;
 }else if(!strcmp(name,"retry_success") || !strcmp(name,"retry_exhaustion")){
  response_command=0x51;response_status=0xff00;response_remaining=!strcmp(name,"retry_success")?2:-1;answer=1;
  bool ok=jo_fs_fill_read_buffer(&file);bool expected_ok=response_remaining==0;
  CHECK(ok==expected_ok);CHECK(handle.position==(expected_ok?1:0));CHECK(file.read_index==(expected_ok?0:19));
  reads=expected_ok?3:11;retries=reads-1;errors=expected_ok?2:11;starts=1;
  reason=4;failed_status=0xff00;failed_command=0x5100;
  CHECK(spins==retries*16);if(ok)CHECK(!memcmp(buffer,payload.data(),2048));
 }else if(!strcmp(name,"max_after_success")){
  frame_step=10;original_field=frames;
  CHECK(__jo_fs_read_sectors(&handle,1,buffer,2048)==-1);
  unsigned expected_max=frames-original_field;
  frame_step=0;answer=1;handle.fad=2000;
  CHECK(__jo_fs_read_sectors(&handle,1,buffer,2048)==2048);
  reads=starts=2;timeouts=1;reason=6;failed_command=0x5100;failed_status=0x0100;
  if(diagnostics){jo_fs_cd_diagnostics x;jo_fs_get_cd_diagnostics(&x);
   CHECK(x.max_read_fields==expected_max && x.max_read_fad==1000 && x.last_read_fields==0);}
 }else if(!strcmp(name,"field_timeout") || !strcmp(name,"clockless_timeout") || !strcmp(name,"wrapped_timeout") || !strcmp(name,"quiet_poll_timeout")){
  if(strcmp(name,"clockless_timeout") && strcmp(name,"quiet_poll_timeout"))frame_step=10;
  if(!strcmp(name,"wrapped_timeout"))frames=0xffffff80u;
  original_field=frames;if(strcmp(name,"quiet_poll_timeout"))__jo_fs_stream_service=cooperate;
  CHECK(__jo_fs_read_sectors(&handle,1,buffer,sizeof buffer)==-1);
  CHECK(handle.position==0);if(strcmp(name,"quiet_poll_timeout"))CHECK(services>1);reads=starts=timeouts=1;reason=6;failed_status=0x0100;failed_command=0x5100;
  if(frame_step)CHECK((unsigned)(frames-original_field)>=300 && (unsigned)(frames-original_field)<=500);
 }else if(!strcmp(name,"wait") || !strcmp(name,"reject") || !strcmp(name,"latched_failure")){
  response_command=0x40;response_status=!strcmp(name,"wait")?0x8100:0xff00;complete_flags=false;
  CHECK(jo_cd_command(0x4000,0,0,0,0x40,nullptr)==-1);
  CHECK(hirq_reads<10);errors=1;reason=4;failed_status=response_status;failed_command=0x4000;
  if(!strcmp(name,"latched_failure")){
   response_status=0x0100;complete_flags=true;
   CHECK(jo_cd_command(0x4000,0,0,0,0x40,nullptr)==0);
  }
 }else if(!strcmp(name,"initial_cmok_timeout")){
  hirq=0;CHECK(jo_cd_command(0x5100,0,0,0,0,nullptr)==-1);
  CHECK(commands[0x51]==0);errors=1;reason=2;failed_status=0xffffffffu;failed_command=0x5100;
 }else if(!strcmp(name,"cmok_timeout")){
  acknowledge=false;CHECK(jo_cd_command(0x5100,0,0,0,0,nullptr)==-1);
  errors=1;reason=3;failed_status=0xffffffffu;failed_command=0x5100;
 }else if(!strcmp(name,"selector_timeout")){
  complete_flags=false;frame_step=1;CHECK(jo_cd_command(0x4000,0,0,0,0x40,nullptr)==-1);
  CHECK(frames>10);errors=1;reason=5;failed_status=0x0100;failed_command=0x4000;
 }else if(!strcmp(name,"async_flush_failure")){
  __jo_cd_async.inflight=true;cr[0]=0xff00;
  CHECK(jo_cd_command(0x5100,0,0,0,0,nullptr)==-1);
  errors=1;reason=1;failed_status=0xffffffffu;failed_command=0x5100;
 }else if(!strcmp(name,"sequential")){
  answer=2;CHECK(__jo_fs_read_sectors(&handle,1,buffer,sizeof buffer)==2048);
  CHECK(__jo_fs_read_sectors(&handle,1,buffer+2048,2048)==2048);
  CHECK(handle.position==2 && !memcmp(buffer,payload.data(),4096));reads=2;starts=1;
 }else if(!strcmp(name,"skip_range")){
  answer=4;CHECK(__jo_fs_read_sectors(&handle,1,buffer,2048)==2048);
  handle.position=2;CHECK(__jo_fs_read_sectors(&handle,1,buffer+4096,2048)==2048);
  CHECK(handle.position==3 && !memcmp(buffer+4096,payload.data()+4096,2048));reads=2;starts=1;
 }else if(!strcmp(name,"zero_read")){
  CHECK(__jo_fs_read_sectors(&handle,0,buffer,sizeof buffer)==0);CHECK(handle.position==0);
 }else return 2;
 CHECK(sr==0x30);
 if(strcmp(name,"async_flush_failure"))CHECK(irq_errors==0);
 jo_fs_cd_diagnostics d,e;memset(&d,0x55,sizeof d);jo_fs_get_cd_diagnostics(&d);
 unsigned before_hirq=hirq_reads;uint64_t before_hash=mmio_hash;unsigned before_field=frames;
 jo_fs_get_cd_diagnostics(nullptr);jo_fs_get_cd_diagnostics(&e);
 CHECK(sizeof d==64 && !memcmp(&d,&e,sizeof d));
 CHECK(before_hirq==hirq_reads && before_hash==mmio_hash && before_field==frames);
 if(diagnostics){
  if(!strcmp(name,"quiet_poll_timeout"))CHECK(diag_fad_writes==3);
  CHECK(d.read_attempts==reads);CHECK(d.start_read_attempts==starts);
  CHECK(d.fill_read_retries==retries);CHECK(d.command_failures==errors);CHECK(d.sector_wait_timeouts==timeouts);
  CHECK(d.failure_reason==reason);
  if(reason){CHECK(d.failure_status==failed_status);CHECK(d.failure_command==failed_command);CHECK(d.failure_fad==(reads?1000:0));}
  if(timeouts && strcmp(name,"max_after_success")){CHECK(d.read_start_field==original_field);CHECK(d.last_read_fields==(unsigned)(frames-original_field));
   CHECK(d.max_read_fields==d.last_read_fields);if(d.max_read_fields)CHECK(d.max_read_fad==1000);}
  if(!strcmp(name,"latched_failure"))CHECK(d.last_status==0x0100 && d.failure_status==0xff00);
 }
 printf("PASS %s mmio=%016llx fields=%u services=%u spins=%u hirq=%u fifo=%zu position=%d\n",name,
  (unsigned long long)mmio_hash,frames,services,spins,hirq_reads,fifo_at,handle.position);
 return 0;
}
