ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
  $(error Undefined YAUL_INSTALL_ROOT)
endif
include $(YAUL_INSTALL_ROOT)/share/build.pre.mk

SH_PROGRAM:= gameplay-runtime-r15-link
SH_BUILD_DIR:= audit/saturn-link-build
SH_OUTPUT_DIR:= audit
SH_SRCS:= \
 src/wf_actor.c src/wf_payment.c src/wf_spatial.c src/wf_target_relation.c src/wf_state5_exec.c src/arcade_cpu_final_bridge.c \
 src/wf_cpu_runtime.c src/wf_gameplay_bindings.c src/wf_damage.c src/wf_scheduler.c \
 src/wf_core_phases.c src/wf_input.c generated/wf_action_matrix.c \
 generated/wf_animation_tables.c generated/wf_physics_tables.c \
 generated/wf_state5_tables.c generated/wf_collision_tables.c src/wf_collision.c \
 src/wf_collision_runtime.c src/wf_collision_dispatch.c src/wf_victim65.c \
 src/wf_ground.c src/wf_pin.c src/wf_ringout.c src/wf_match_rules.c \
 src/wf_royal.c src/wf_doomsday.c src/wf_animation.c src/wf_physics.c \
 src/wf_camera.c src/wf_visual.c src/wf_graphics.c src/wf_vdp1_plan.c \
 src/wf_combat_frame.c src/wf_saturn_render_bridge.c src/wf_saturn_memory.c \
 src/wf_saturn_yaul_backend.c src/wf_saturn_combat_present.c src/wf_saturn_entry.c
SH_CFLAGS+= -Os -Iinclude -Wall -Wextra -Werror -DWF_PLATFORM_SATURN=1
SH_DEFSYMS+= -Wl,--defsym=___master_stack=0x06004000 -Wl,--defsym=___slave_stack=0x06001E00

# ELF-only audit gate. Do not generate a Saturn BIN/CUE unless explicitly requested.
OUTPUT_FILES:= $(SH_BUILD_PATH)/$(SH_PROGRAM).elf
CLEAN_OUTPUT_FILES:= $(OUTPUT_FILES)

include $(YAUL_INSTALL_ROOT)/share/build.post.bin.mk
