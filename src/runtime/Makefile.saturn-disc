ifeq ($(strip $(YAUL_INSTALL_ROOT)),)
  $(error Undefined YAUL_INSTALL_ROOT)
endif
SH_PROGRAM:= wrestlefest-runtime18
SH_BUILD_DIR:= audit/runtime18-build
SH_OUTPUT_DIR:= audit/runtime18-disc

# build.pre.mk expands the map filename immediately from these settings.
include $(YAUL_INSTALL_ROOT)/share/build.pre.mk

SH_SRCS:= \
 src/wf_actor.c src/wf_payment.c src/wf_spatial.c src/wf_target_relation.c src/wf_pair_relation.c src/wf_actor_prepass.c src/wf_state5_exec.c src/arcade_cpu_final_bridge.c \
 src/wf_cpu_runtime.c src/wf_gameplay_bindings.c src/wf_damage.c src/wf_scheduler.c \
 src/wf_core_phases.c src/wf_input.c generated/wf_action_matrix.c \
 generated/wf_animation_tables.c generated/wf_physics_tables.c \
 generated/wf_state5_tables.c generated/wf_collision_tables.c src/wf_collision.c \
 src/wf_collision_runtime.c src/wf_collision_dispatch.c src/wf_victim65.c \
 src/wf_ground.c src/wf_pin.c src/wf_ringout.c src/wf_match_rules.c \
 src/wf_royal.c src/wf_doomsday.c src/wf_animation.c src/wf_physics.c \
 src/wf_camera.c src/wf_visual.c src/wf_graphics.c src/wf_vdp1_plan.c \
 src/wf_combat_frame.c src/wf_saturn_render_bridge.c src/wf_saturn_memory.c \
 src/wf_saturn_yaul_backend.c src/wf_saturn_combat_present.c src/wf_saturn_entry.c \
 src/wf_r17_m68k_shadow.c src/wf_r17_bootstrap.c src/wf_r17_rng1129e.c \
 src/wf_r17_human_ddc8.c src/wf_r17_human_raw23.c src/wf_r17_raw23.c \
 src/wf_r17_actions_r11.c src/wf_r17_dispatch_1c03e.c src/wf_r17_resolver_280dc.c src/wf_r17_collision_24062.c src/wf_r17_ringside_fdee.c src/wf_r17_fixed_four_10120.c src/wf_r17_transient_reset_10e6a.c src/wf_r17_effects_7a00.c src/wf_r17_render_contract.c src/wf_r17_referee.c src/wf_r17_scheduler_owners.c \
 src/wf_r17_follow_10e86.c src/wf_r17_dependencies.c src/wf_r17_integration.c src/wf_r17_post7a00.c src/wf_r17_postack_2017a.c
SH_SRCS+= src/wf_r17_participant_helpers.c src/wf_r17_participant_native.c src/wf_r17_royal_9132.c src/wf_r17_tag_6e34.c
SH_SRCS+= src/wf_r18_bootstrap.c src/wf_r18_cdfs.c src/wf_r18_metasprite.c src/wf_r18_present.c src/wf_r18_ring.c src/wf_r18_video.c src/wf_r18_world.c
SH_CFLAGS+= -O2 -Iinclude -Wall -Wextra -Werror -DWF_PLATFORM_SATURN=1
SH_DEFSYMS+= -Wl,--defsym=___master_stack=0x06004000 -Wl,--defsym=___slave_stack=0x06001E00

# Proven WP33 / Yaul single-data-track boot contract.
IMAGE_DIRECTORY:= audit/runtime18-cd
AUDIO_TRACKS_DIRECTORY:= audit/runtime18-empty-audio
IP_VERSION:= V0.018
IP_RELEASE_DATE:= 20261018
IP_AREAS:= JTUBKAEL
IP_PERIPHERALS:= J
IP_TITLE:= WWF WrestleFest Runtime18
IP_MASTER_STACK_ADDR:= 0x06004000
IP_SLAVE_STACK_ADDR:= 0x06001E00
IP_1ST_READ_ADDR:= 0x06004000
IP_1ST_READ_SIZE:= -1
include $(YAUL_INSTALL_ROOT)/share/build.post.iso-cue.mk

pre-build-iso:
	@mkdir -p $(IMAGE_DIRECTORY)
	@printf 'WrestleFest Saturn Runtime18 direct combat build\n' > $(IMAGE_DIRECTORY)/ABS.TXT
	@printf 'Boot/CD pipeline: WF-CLEAN-R01 WP33 and Yaul SDK\n' > $(IMAGE_DIRECTORY)/BIB.TXT
	@printf 'WrestleFest assets retain their original rights holders.\n' > $(IMAGE_DIRECTORY)/CPY.TXT
